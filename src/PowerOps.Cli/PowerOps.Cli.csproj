<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>powerops</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>powerops</ToolCommandName>
    <PackageId>PowerOps</PackageId>
    <Description>Open-source CLI toolkit that brings analysis, diffing, testing and repeatable deployment to Microsoft Power Platform.</Description>
    <PackageTags>powerplatform;dataverse;alm;devops;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The Action builds this project from source in consumers' jobs, and locked mode checks each package's content hash; the test projects have no lock file because of dependabot-core#13950. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerOps.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PowerOps.Core/PowerOps.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../skills/**/*" LogicalName="skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
