kind: TaskDialog
confirmation:
  activity: Run add a new row?
  mode: Strict

inputs:
  - kind: ManualTaskInput
    propertyName: organization
    value: current

  - kind: ManualTaskInput
    propertyName: entityName
    value: demo_tickets

  - kind: AutomaticTaskInput
    propertyName: item.'demo_Queue@odata.bind'
    description: "The queue that holds the ticket, as an OData bind."

modelDisplayName: Add a new row
modelDescription: A made-up description of the add a new row tool.
outputs:
  - propertyName: "@odata.id"
    name: OData Id
    description: A made-up description of the odata id.

action:
  kind: InvokeConnectorTaskAction
  connectionReference: demo_Helper.shared_commondataserviceforapps.shared-commondataser-0000001
  connectionProperties:
    mode: Invoker

  operationId: CreateRecordWithOrganization
  dynamicInputSchema:
    properties:
      entityName:
        displayName: Table name
        isRequired: true
        type: String
      item:
        type:
          kind: Record
          properties:
            demo_Queue@odata.bind:
              displayName: Queue
              type: String

  dynamicOutputSchema:
    kind: Record
    properties:
      "@odata.id":
        displayName: OData Id
        description: A made-up description of the odata id.
        type: String
      demo_ticketid:
        displayName: Ticket
        type: String

outputMode: All
