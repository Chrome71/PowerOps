{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pops_SeedDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "On Call Board Url (pops_OnCallBoardUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "pops_OnCallBoardUrl",
            "description": "Address of the on-call board for each environment"
          }
        },
        "On Call Board Token (pops_OnCallBoardToken)": {
          "defaultValue": "",
          "type": "SecureString",
          "metadata": {
            "schemaName": "pops_OnCallBoardToken",
            "description": "Credential for the on-call board"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "6"
              ],
              "minutes": [
                0
              ]
            },
            "timeZone": "UTC"
          }
        }
      },
      "actions": {
        "List_stale_work_items": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000502"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pops_workitems",
              "$select": "pops_name",
              "$filter": "@concat('statecode eq 0 and createdon lt ', addDays(utcNow(), -14))"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Check_for_stale_items": {
          "runAfter": {
            "List_stale_work_items": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "greater": [
              "@length(body('List_stale_work_items')?['value'])",
              0
            ]
          },
          "actions": {
            "Post_to_the_board": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@parameters('On Call Board Url (pops_OnCallBoardUrl)')",
                "headers": {
                  "Content-Type": "application/json",
                  "Authorization": "@concat('Bearer ', parameters('On Call Board Token (pops_OnCallBoardToken)'))"
                },
                "body": {
                  "staleCount": "@length(body('List_stale_work_items')?['value'])"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
