      "tool": {
        "driver": {
          "name": "PowerOps",
          "informationUri": "https://github.com/Chrome71/PowerOps",
          "version": "1.2.3",
          "rules": [
            {
              "id": "PO001",
              "name": "UndefinedConnectionReference",
              "shortDescription": {
                "text": "Flow uses a connection reference that is not defined"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO001.md",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO002",
              "name": "RequiredEnvironmentVariableWithoutValue",
              "shortDescription": {
                "text": "Required environment variable has no default or current value"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO002.md",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO003",
              "name": "DependencyWithoutOwningSolution",
              "shortDescription": {
                "text": "Missing dependency has no owning solution"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO003.md",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO004",
              "name": "UndefinedChildFlow",
              "shortDescription": {
                "text": "Flow calls a child flow that is not defined"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO004.md",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO005",
              "name": "UnusedConnectionReference",
              "shortDescription": {
                "text": "Connection reference is not used by any flow or app"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO005.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO006",
              "name": "HardCodedEnvironmentUrl",
              "shortDescription": {
                "text": "Flow contains a hard-coded environment or SharePoint site URL"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO006.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO007",
              "name": "EnvironmentSpecificDefaultValue",
              "shortDescription": {
                "text": "Environment variable default value looks environment-specific"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO007.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO008",
              "name": "ShippedCurrentValue",
              "shortDescription": {
                "text": "Environment variable ships a current value"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO008.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO009",
              "name": "ForeignPrefix",
              "shortDescription": {
                "text": "Component name does not use the publisher prefix"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO009.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO010",
              "name": "DefaultPublisher",
              "shortDescription": {
                "text": "Solution uses a default or generated publisher prefix"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO010.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO011",
              "name": "FlowOff",
              "shortDescription": {
                "text": "Cloud flow is turned off"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO011.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO012",
              "name": "RowUpdatedTriggerWithoutFilterColumns",
              "shortDescription": {
                "text": "Dataverse row-updated trigger has no filter columns"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO012.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
