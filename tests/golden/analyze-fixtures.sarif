{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PowerOps",
          "informationUri": "https://github.com/Chrome71/PowerOps",
          "version": "1.2.3",
          "rules": [
            {
              "id": "PO001",
              "name": "UndefinedConnectionReference",
              "shortDescription": {
                "text": "Flow uses a connection reference that is not defined"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO001.md",
              "help": {
                "text": "Add the connection reference to the solution, or add the solution that owns it as a dependency."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO002",
              "name": "RequiredEnvironmentVariableWithoutValue",
              "shortDescription": {
                "text": "Required environment variable has no default or current value"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO002.md",
              "help": {
                "text": "Give the variable a default value, or supply the value at deployment time and keep it out of the solution."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO003",
              "name": "DependencyWithoutOwningSolution",
              "shortDescription": {
                "text": "Missing dependency has no owning solution"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO003.md",
              "help": {
                "text": "Add the missing component to the solution, or import the solution that provides it first."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO004",
              "name": "UndefinedChildFlow",
              "shortDescription": {
                "text": "Flow calls a child flow that is not defined"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO004.md",
              "help": {
                "text": "Add the child flow to the solution, or add the solution that contains it as a dependency."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO005",
              "name": "UnusedConnectionReference",
              "shortDescription": {
                "text": "Connection reference is not used by any flow or app"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO005.md",
              "help": {
                "text": "Remove the connection reference from the solution, or use it in the flow or app that needs it."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO006",
              "name": "HardCodedEnvironmentUrl",
              "shortDescription": {
                "text": "Flow contains a hard-coded environment or SharePoint site URL"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO006.md",
              "help": {
                "text": "Remove the URL where the platform can use the current environment, otherwise read it from an environment variable whose value is set per environment at deployment."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO007",
              "name": "EnvironmentSpecificDefaultValue",
              "shortDescription": {
                "text": "Environment variable default value looks environment-specific"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO007.md",
              "help": {
                "text": "Leave the default empty and set the value per environment at deployment time, or use a default that is valid everywhere."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO008",
              "name": "ShippedCurrentValue",
              "shortDescription": {
                "text": "Environment variable ships a current value"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO008.md",
              "help": {
                "text": "Remove the current value before export, and supply per-environment values with deployment settings."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO009",
              "name": "ForeignPrefix",
              "shortDescription": {
                "text": "Component name does not use the publisher prefix"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO009.md",
              "help": {
                "text": "Recreate the component under the solution's publisher, or keep it in a solution of the publisher that owns it and add that solution as a dependency."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO010",
              "name": "DefaultPublisher",
              "shortDescription": {
                "text": "Solution uses a default or generated publisher prefix"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO010.md",
              "help": {
                "text": "Create a publisher with a meaningful prefix and build the solution under it."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO011",
              "name": "FlowOff",
              "shortDescription": {
                "text": "Cloud flow is turned off"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO011.md",
              "help": {
                "text": "Turn the flow on before export, or remove it from the solution if it is no longer needed."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO012",
              "name": "RowUpdatedTriggerWithoutFilterColumns",
              "shortDescription": {
                "text": "Dataverse row-updated trigger has no filter columns"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO012.md",
              "help": {
                "text": "Set the trigger's filter columns to the columns whose update should start the flow."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO013",
              "name": "RootComponentWithoutSourceFolder",
              "shortDescription": {
                "text": "Root component has no source folder in the YAML layout"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO013.md",
              "help": {
                "text": "Commit the component's folder and list it in solutioncomponents.yml, or remove the component from rootcomponents.yml."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO014",
              "name": "CanvasHardCodedUrl",
              "shortDescription": {
                "text": "Canvas app formula contains a hard-coded environment or SharePoint site URL"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO014.md",
              "help": {
                "text": "Remove the URL where the platform can use the current environment, otherwise read it from an environment variable whose value is set per environment at deployment."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO015",
              "name": "CreateTriggerWithFilterColumns",
              "shortDescription": {
                "text": "Dataverse row-created trigger has filter columns"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO015.md",
              "help": {
                "text": "Clear the trigger's filter columns, or change its change type to Create or Update."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO016",
              "name": "FlowSizeOrDepth",
              "shortDescription": {
                "text": "Cloud flow has more than 50 actions or more than 4 levels of nesting"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO016.md",
              "help": {
                "text": "Move self-contained parts of the flow into child flows, and reduce nested scopes, conditions and loops."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO017",
              "name": "NestedLoop",
              "shortDescription": {
                "text": "Cloud flow runs a loop inside a loop"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO017.md",
              "help": {
                "text": "Replace the inner loop with one query, filter or bulk action over the whole set, or fetch the related rows with the outer query's expand option and use one loop."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO018",
              "name": "CanvasForAllPatch",
              "shortDescription": {
                "text": "Canvas app formula calls Patch or ForAll inside ForAll"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO018.md",
              "help": {
                "text": "Pass the ForAll result to one Patch call instead of calling Patch inside ForAll, and avoid nesting ForAll."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO019",
              "name": "WebApiWildcardFields",
              "shortDescription": {
                "text": "Power Pages Web API fields setting is *"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO019.md",
              "help": {
                "text": "Replace * with the comma-separated logical names of the columns the site needs, or set UseFieldsFromView to True with a view that holds them."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO020",
              "name": "WebApiNoFields",
              "shortDescription": {
                "text": "Power Pages Web API is enabled for a table with no fields setting"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO020.md",
              "help": {
                "text": "Add a fields site setting for the table with the columns the site needs, or set its UseFieldsFromView site setting to True with a view that holds them."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO021",
              "name": "PermissionWithoutRole",
              "shortDescription": {
                "text": "Power Pages table permission has no web role"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO021.md",
              "help": {
                "text": "Associate the table permission with the web roles that need it, or delete it."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO022",
              "name": "ChildPermissionRoles",
              "shortDescription": {
                "text": "Power Pages child table permission is not in effect through its parent"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO022.md",
              "help": {
                "text": "Give the parent table permission the child's web roles or remove them from the child, and keep the parent active."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO023",
              "name": "AnonymousWrite",
              "shortDescription": {
                "text": "Power Pages table permission lets anonymous users create, write or delete"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO023.md",
              "help": {
                "text": "Remove create, write and delete from the anonymous role's table permission, or grant them to a role that requires sign-in."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO024",
              "name": "SiteMapPageMissing",
              "shortDescription": {
                "text": "Site map opens a custom page that is not in the solution"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO024.md",
              "help": {
                "text": "Add the custom page to the solution, or add the solution that holds it as a dependency."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO025",
              "name": "AppPageLimits",
              "shortDescription": {
                "text": "Model-driven app has more than 25 custom pages, 10 connectors or 20 connection references"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO025.md",
              "help": {
                "text": "Move custom pages to another app, or remove pages and connections, until the app has at most 25 custom pages, 10 connectors and 20 connection references."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO026",
              "name": "CodeAppDependencyMissing",
              "shortDescription": {
                "text": "Code app depends on a table or connector that is not in the solution"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO026.md",
              "help": {
                "text": "Add the table or connector to the solution, or add the solution that holds it as a dependency."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO027",
              "name": "McpToolWithoutGenerativeOrchestration",
              "shortDescription": {
                "text": "MCP server on an agent with generative orchestration off"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO027.md",
              "help": {
                "text": "Turn on generative orchestration for the agent, or remove the MCP server."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PO028",
              "name": "AgentInstructionsLength",
              "shortDescription": {
                "text": "Agent instructions are empty or longer than 8,000 characters"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO028.md",
              "help": {
                "text": "Write the agent's instructions, in at most 8,000 characters."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO029",
              "name": "AgentWithoutAuthentication",
              "shortDescription": {
                "text": "Agent authentication is None"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO029.md",
              "help": {
                "text": "Set the agent's authentication to Authenticate with Microsoft or Authenticate manually."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO030",
              "name": "ToolMakerConnection",
              "shortDescription": {
                "text": "Agent tool uses the maker's credentials"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO030.md",
              "help": {
                "text": "Set the tool to use end-user credentials, unless every user may act with the maker's permissions or a trigger calls the tool."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO031",
              "name": "AgentToolCount",
              "shortDescription": {
                "text": "Agent has more than 30 tools"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO031.md",
              "help": {
                "text": "Remove tools the agent doesn't need."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO032",
              "name": "AppSharedWithAdminsOnly",
              "shortDescription": {
                "text": "Model-driven app is shared only with admin roles"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO032.md",
              "help": {
                "text": "Share the app with the security roles its users hold, and remove System Administrator and System Customizer from it unless they need the app."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO033",
              "name": "RoleWithoutAppBaseline",
              "shortDescription": {
                "text": "Custom security role has no privilege to open a model-driven app"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO033.md",
              "help": {
                "text": "Copy the role from App Opener, or give its users App Opener as well, and test the app as a user who holds only those roles."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO034",
              "name": "RoleWritesUnusedTable",
              "shortDescription": {
                "text": "Security role can create or write a table that no component in the solution uses"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO034.md",
              "help": {
                "text": "Check whether the role's users need to create or write that table, and remove those privileges from the role if they don't."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PO035",
              "name": "NavigationName",
              "shortDescription": {
                "text": "Flow names a navigation property in the wrong case"
              },
              "helpUri": "https://github.com/Chrome71/PowerOps/blob/main/docs/rules/PO035.md",
              "help": {
                "text": "Write the navigation property name exactly as the table's relationship defines it, in the same case."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
