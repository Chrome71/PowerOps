{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chrome71/PowerOps/main/docs/schemas/inventory.schema.json",
  "title": "powerops inventory --format json",
  "description": "The JSON written by 'powerops inventory --format json': per solution, what it connects to and the licence drivers it fires. Names are redacted unless --show-values is given, so two entries may print alike.",
  "type": "object",
  "required": ["schemaVersion", "solutions"],
  "$defs": {
    "names": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "schemaVersion": { "const": 1, "description": "Version of this output format." },
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "uniqueName", "licenceDrivers", "notClassified", "connectors", "customConnectors", "httpActions", "requestTriggers", "childFlows", "notRead"],
        "properties": {
          "path": { "type": "string", "description": "The display path: relative to the current folder when under it, with / on every OS; a YAML solution's root folder." },
          "uniqueName": { "type": "string" },
          "licenceDrivers": {
            "type": "array",
            "description": "The drivers of the closed set that fire, in table order. A solution with none may still need a premium licence.",
            "items": {
              "type": "object",
              "required": ["id", "need", "sources", "verified", "where"],
              "properties": {
                "id": { "enum": ["http-action", "custom-connector", "dataverse-in-canvas-app", "model-driven-app", "desktop-flow-call"] },
                "need": { "type": "string", "description": "The licence it needs, in one sentence." },
                "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://learn\\.microsoft\\.com/" } },
                "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The date the sources were checked." },
                "where": { "$ref": "#/$defs/names", "minItems": 1, "description": "What fires it." }
              }
            }
          },
          "notClassified": {
            "type": "array",
            "description": "Every connector that is neither a custom connector nor the desktop flows connector, sorted by id.",
            "items": {
              "type": "object",
              "required": ["id", "note"],
              "properties": {
                "id": { "type": "string" },
                "note": { "const": "tier not classified: check the connector's reference page" }
              }
            }
          },
          "connectors": {
            "type": "array",
            "description": "One entry per connector id (the last segment of the id or api name, in lower case, or a custom connector's name), sorted by id.",
            "items": {
              "type": "object",
              "required": ["id", "references", "users"],
              "properties": {
                "id": { "type": "string" },
                "references": { "$ref": "#/$defs/names", "description": "Logical names of the connection references that name it." },
                "users": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "name"],
                    "properties": {
                      "kind": { "enum": ["flow", "canvasApp", "customPage", "codeApp", "agentTool"] },
                      "name": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "customConnectors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "inSolution"],
              "properties": {
                "name": { "type": "string" },
                "inSolution": { "type": "boolean", "description": "True when it is a root component of the solution." }
              }
            }
          },
          "httpActions": {
            "type": "array",
            "description": "The Http and HttpWebhook actions, in flow then walk order.",
            "items": {
              "type": "object",
              "required": ["flow", "action", "type", "endpoint", "host"],
              "properties": {
                "flow": { "type": "string" },
                "action": { "type": "string" },
                "type": { "type": "string" },
                "endpoint": { "enum": ["literal", "variable", "expression"] },
                "host": { "type": ["string", "null"], "description": "The host of a literal http or https URL, only with --show-values; null otherwise." }
              }
            }
          },
          "requestTriggers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["flow", "trigger", "kind"],
              "properties": {
                "flow": { "type": "string" },
                "trigger": { "type": "string" },
                "kind": { "type": ["string", "null"] }
              }
            }
          },
          "childFlows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["flow", "child"],
              "properties": {
                "flow": { "type": "string" },
                "child": { "type": ["string", "null"], "description": "The called flow's name; null when the solution doesn't hold it." }
              }
            }
          },
          "notRead": { "$ref": "#/$defs/names", "description": "What was not read, and so is not reported." }
        }
      }
    }
  }
}
